POSTGRES_DB=routecommunity
POSTGRES_USER=routecommunity
POSTGRES_PASSWORD=routecommunity
POSTGRES_PORT=8152

API_PORT=8151
WEB_PORT=8150
NEXT_PUBLIC_API_URL=http://localhost:8151

GPX_MAX_FILE_SIZE=10MB
GPX_MAX_REQUEST_SIZE=11MB
GPX_MAX_FILE_SIZE_BYTES=10485760
GPX_STORAGE_PATH=/data/gpx
API_INTERNAL_URL=http://api:8080
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Public origin used in server-side web metadata (independent of API_INTERNAL_URL).
SITE_URL=https://tweakmyroute.com
# Local OG rendering needs no network services or credentials. See SHARE_PREVIEWS.md.
ROUTE_PREVIEW_POLL_DELAY_MS=5000

# Install DEM tiles first; see ELEVATION.md. Use remote explicitly for development without DEM.
ELEVATION_PROVIDER=local-dem
ELEVATION_DATA_PATH=/home/malupixel/data/elevation
ELEVATION_SAMPLE_INTERVAL_METERS=100
ELEVATION_CACHE_MEGABYTES=128
ELEVATION_BASE_URL=https://api.open-meteo.com
# Administrative API remains disabled until a random secret is configured.
# Generate locally: openssl rand -hex 32. Never commit the resulting value.
ADMIN_SECRET=5c806300bd7801ec40aa84a92bcf8119d095589bfb0c39a32d8f3109fd5d7821
